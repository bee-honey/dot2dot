# Copy this file to .env and fill in your values:
#     cp .env.example .env
# .env is git-ignored, so your key never gets committed.

# OpenAI API key, used by the AI planner (optional; the app works without it).
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which OpenAI model the planner uses (must accept images). Leave empty for
# the default, gpt-4.1: fast (~3s) with accurate part boxes.
# gpt-5.5 gives the most precise plans but takes 10-15s.
DOT2DOT_OPENAI_MODEL=
